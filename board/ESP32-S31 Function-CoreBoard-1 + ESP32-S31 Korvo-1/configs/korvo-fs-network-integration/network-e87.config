# E87 network policy, only for korvo-fs-network-integration validation.
# Textual choices only; resolve and verify with Kconfig before building.
# E94 TCP32000 is a socket request/readback, not a global queue maximum.
CONFIG_NET_TCPBACKLOG=y
CONFIG_NET_TCPBACKLOG_CONNS=1
CONFIG_IOB_NBUFFERS=256
CONFIG_IOB_BUFSIZE=400
CONFIG_IOB_NCHAINS=32
CONFIG_IOB_THROTTLE=24
CONFIG_NET_RECV_BUFSIZE=16384
CONFIG_NET_SEND_BUFSIZE=16384
CONFIG_NET_MAX_RECV_BUFSIZE=65536
CONFIG_NET_MAX_SEND_BUFSIZE=65536
CONFIG_UTILS_IPERF2_PRIORITY=100
CONFIG_UTILS_IPERF2_STACKSIZE=8192
CONFIG_UTILS_IPERF2_TCP_BUFSIZE=16384
CONFIG_UTILS_IPERF2_RECV_BUFSIZE=16384
CONFIG_UTILS_IPERF2_DATA_REPORT_NUM=100
# CONFIG_ESPRESSIF_WIFI_STA_11AX is not set

# Preserve the existing BGN / PS_NONE policy explicitly.
CONFIG_ESP_POWER_SAVE_NONE=y
# CONFIG_ESP_POWER_SAVE_MIN_MODEM is not set
# CONFIG_ESP_POWER_SAVE_MAX_MODEM is not set
