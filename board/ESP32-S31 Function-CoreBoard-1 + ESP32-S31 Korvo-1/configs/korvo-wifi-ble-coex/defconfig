# Korvo Wi-Fi / BLE coexistence through the standard WAPI and bttool APIs.
# Association is explicit. Keep credentials in RAM and restore the test image.
#include "../demo-rmt-bttool-coex-multi/defconfig"

CONFIG_ESP32S31_BOARD_KORVO=y
# CONFIG_NSH_NETINIT is not set
# CONFIG_WIRELESS_WAPI_INITCONF is not set
# CONFIG_BT_PRIVACY is not set
CONFIG_SYSTEM_SYSTEM=y
CONFIG_SYSTEM_SYSTEM_SHPATH="/system/bin/sh"
CONFIG_SYSTEM_SYSTEM_STACKSIZE=8192
CONFIG_SYSTEM_NSH_STACKSIZE=8192
CONFIG_INIT_STACKSIZE=8192
CONFIG_UART0_RXBUFSIZE=256
CONFIG_NETUTILS_CODECS=y
CONFIG_CODECS_HASH_MD5=y
# CONFIG_NSH_DISABLE_MD5 is not set
CONFIG_NSH_BUILTIN_AS_COMMAND=y
CONFIG_NSH_QUOTE=y
# CONFIG_NSH_ARGCAT is not set
CONFIG_ARCH_HEAP_INITIAL_NPAGES=16
CONFIG_ARCH_HEAP_NPAGES=1024
CONFIG_ARCH_TEXT_NPAGES=512
CONFIG_ELF_APP_MAX_FILESIZE=2097152
CONFIG_ESPRESSIF_STORAGE_MTD_OFFSET=0x200000
CONFIG_ESPRESSIF_STORAGE_MTD_SIZE=0xe00000
CONFIG_ESP32S31_FLASH_APPFS_SEED_SIZE=0xc00000
# CONFIG_ESP32S31_FLASH_APPFS_SEED_INSTALL is not set
