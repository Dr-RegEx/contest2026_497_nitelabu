# Korvo SMP product: native services, display, MEDIA, Wi-Fi and BLE.
# Use a matched kernel/AppFS pair. Services and association start explicitly.
#include "../korvo-smp-services/defconfig"

# Use the existing CPU0 controller dispatcher in KERNEL/SMP.
# Wi-Fi and BLE share the existing SMP coexistence path.
CONFIG_RTC=y
CONFIG_RTC_DRIVER=y
CONFIG_DRIVERS_WIRELESS=y
CONFIG_ESP32S31_BLE=y
CONFIG_USEC_PER_TICK=1000
CONFIG_UART_BTH4_RXBUFSIZE=8192
CONFIG_PTHREAD_STACK_MIN=4096
CONFIG_DEV_URANDOM=y
CONFIG_DEV_URANDOM_ARCH=y

# Existing public framework/tool path. Local mode creates its own service loop
# when bttool starts; do not additionally launch bluetoothd.
CONFIG_LIBUV=y
CONFIG_LIBUV_EXTENSION=y
CONFIG_UNQLITE=y
CONFIG_FS_LOCK_BUCKET_SIZE=8
CONFIG_NET=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NET_LOCAL=y
CONFIG_NET_LOCAL_STREAM=y
CONFIG_NET_SOCKOPTS=y
CONFIG_EPOLL=y
CONFIG_PIPES=y
CONFIG_BLUETOOTH=y
CONFIG_BLUETOOTH_FRAMEWORK=y
CONFIG_BLUETOOTH_FRAMEWORK_LOCAL=y
CONFIG_BLUETOOTH_SERVICE=y
CONFIG_BLUETOOTH_TOOLS=y
# CONFIG_BLUETOOTH_SERVER is not set
# CONFIG_BLUETOOTH_ADAPTER_TEST is not set
# CONFIG_BLUETOOTH_BREDR_SUPPORT is not set
CONFIG_BLUETOOTH_BLE_SUPPORT=y
CONFIG_BLUETOOTH_BLE_ADV=y
CONFIG_BLUETOOTH_BLE_SCAN=y
CONFIG_BLUETOOTH_STACK_LE_ZBLUE=y
CONFIG_BLUETOOTH_STORAGE_UNQLITE_SUPPORT=y
CONFIG_BLUETOOTH_TASK_STACK_SIZE=8192
CONFIG_BLUETOOTH_SERVICE_LOOP_THREAD_STACK_SIZE=8192

# Match the real H4/ACL constraint and awake LE roles from the BLE baselines.
CONFIG_BT=y
CONFIG_BT_HCI=y
CONFIG_BT_HCI_HOST=y
CONFIG_BT_OBSERVER=y
CONFIG_BT_BROADCASTER=y
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_CENTRAL=y
# CONFIG_BT_NATIVE is not set
CONFIG_BT_H4=y
CONFIG_BT_UART_ON_DEV_NAME="/dev/ttyHCI0"
CONFIG_BT_BUF_ACL_RX_SIZE=1021
CONFIG_BT_SMP=y
CONFIG_BT_PRIVACY=y
# CONFIG_BT_CENTRAL_FORCE_IDENTITY_ADDR is not set
# CONFIG_BT_DEBUG_LOG is not set
# CONFIG_BT_GATT_CACHING is not set
CONFIG_BT_HCI_TX_STACK_SIZE_WITH_PROMPT=y
CONFIG_BT_HCI_TX_STACK_SIZE=4096
CONFIG_BT_RX_STACK_SIZE=4096
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_LIBC_USRWORK=y
CONFIG_LIBC_USRWORKSTACKSIZE=4096

# Keep BLE active while bttool's ! escape invokes existing AM/resource tools.
# system() is a library source, and /system/bin/sh is already in AppFS.
CONFIG_SYSTEM_SYSTEM=y
CONFIG_SYSTEM_SYSTEM_SHPATH="/system/bin/sh"
CONFIG_SYSTEM_SYSTEM_STACKSIZE=8192

# E346's bounded GATT client plus E398's two-advertiser host capacity.
# This preserves scan, connect, discovery, read, write and notifications.
# CONFIG_BLUETOOTH_GATT is not set
CONFIG_BLUETOOTH_GATT_CLIENT=y
CONFIG_BLUETOOTH_GATTC_MAX_CONNECTIONS=1
CONFIG_BT_GATT_CLIENT=y
CONFIG_GATT_CLIENT_SERVICE_MAX=8
CONFIG_GATT_CLIENT_ELEMENT_MAX=64
CONFIG_GATT_CLIENT_CHAR_PER_SERVICE_MAX=16
CONFIG_BLUETOOTH_GATT_SERVER=y
CONFIG_BT_GATT_DYNAMIC_DB=y
CONFIG_BT_MAX_CONN=2
CONFIG_BT_EXT_ADV_MAX_ADV_SET=2
CONFIG_BLUETOOTH_LE_ADVERTISER_MAX_NUM=2

# Preserve the network buffers and standard WAPI path used by the SMP
# coexistence profile. Never embed credentials or connect during boot.
CONFIG_ESPRESSIF_WIFI=y
CONFIG_ESPRESSIF_WIFI_STATION=y
# CONFIG_ESPRESSIF_SPIRAM_USER_HEAP is not set
# CONFIG_ESPRESSIF_WIFI_STA_11AX is not set
CONFIG_WIRELESS=y
CONFIG_WIRELESS_WAPI=y
CONFIG_WIRELESS_WAPI_CMDTOOL=y
# CONFIG_WIRELESS_WAPI_INITCONF is not set
# CONFIG_NSH_NETINIT is not set
CONFIG_NETDEV_WIRELESS_IOCTL=y
CONFIG_NET_BROADCAST=y
CONFIG_NET_ETH_PKTSIZE=1514
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NET_TCP_DELAYED_ACK=y
CONFIG_NET_TCP_KEEPALIVE=y
CONFIG_NET_TCP_WRITE_BUFFERS=y
CONFIG_NET_UDP_CHECKSUMS=y
CONFIG_NET_UDP_WRITE_BUFFERS=y
CONFIG_NET_SEND_BUFSIZE=16384
CONFIG_IOB_BUFSIZE=400
CONFIG_IOB_NBUFFERS=96
CONFIG_IOB_NCHAINS=32
CONFIG_IOB_THROTTLE=24
CONFIG_SYSTEM_DHCPC_RENEW=y
CONFIG_SYSTEM_PING=y
CONFIG_BT_LONG_WQ_STACK_SIZE=4096

# Exercise actual platform APIs and product-size software JPEG in this pair.
CONFIG_EXAMPLES_S31FOUNDATION=y
CONFIG_LIB_JPEG_TURBO=y
CONFIG_EXAMPLES_JPEGTEST=y
CONFIG_EXAMPLES_JPEGTEST_STACKSIZE=8192
