# Validation candidate: match the locked stock-IDF performance settings.
# This does not replace the maintained or previously qualified profiles.
#include "../korvo-fs-network-integration/defconfig"

# LittleFS: read/prog/block/cache/lookahead/cycles = 128/128/4096/512/128/512.
CONFIG_ESPRESSIF_SPIFLASH_MTD_BLKSIZE=128
CONFIG_FS_LITTLEFS_READ_SIZE_FACTOR=1
CONFIG_FS_LITTLEFS_PROGRAM_SIZE_FACTOR=1
CONFIG_FS_LITTLEFS_BLOCK_SIZE_FACTOR=1
CONFIG_FS_LITTLEFS_CACHE_SIZE_FACTOR=4
CONFIG_FS_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_FS_LITTLEFS_BLOCK_CYCLE=512
# CONFIG_FS_LITTLEFS_COALESCE is not set
CONFIG_STDIO_DISABLE_AUTO_READ_WINDOW=y
CONFIG_ESP32S31_FLASH_STAGING_BYTES=64

# Keep the shared driver-side buffer counts, already equal to stock IDF.
CONFIG_ESPRESSIF_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESPRESSIF_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESPRESSIF_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESPRESSIF_WIFI_TX_BA_WIN=6
CONFIG_ESPRESSIF_WIFI_RX_BA_WIN=6
CONFIG_ESPRESSIF_WIFI_STA_11AX=y
# CONFIG_ESP_POWER_SAVE_NONE is not set
CONFIG_ESP_POWER_SAVE_MIN_MODEM=y
# CONFIG_ESP_POWER_SAVE_MAX_MODEM is not set

# NuttX IOB objects are not lwIP mailboxes: retain the smaller prior pool.
CONFIG_IOB_NBUFFERS=128
CONFIG_NET_RECV_BUFSIZE=5760
CONFIG_NET_SEND_BUFSIZE=5760
CONFIG_NET_MAX_RECV_BUFSIZE=5760
CONFIG_NET_MAX_SEND_BUFSIZE=5760
CONFIG_UTILS_IPERF2_TCP_BUFSIZE=2880
CONFIG_UTILS_IPERF2_RECV_BUFSIZE=2880

# Stock IDF uses -Og.  KERNEL/SMP/MMU and required PSRAM remain platform needs.
# CONFIG_DEBUG_FULLOPT is not set
CONFIG_DEBUG_CUSTOMOPT=y
CONFIG_DEBUG_OPTLEVEL="-Og"
