#include "../xts-flat-rtc/defconfig"

# Korvo ES8389 standard PCM qualification, no real-media auto capture/save.
CONFIG_ESP32S31_BOARD_KORVO=y
# CONFIG_ESP32S31_BOARD_FUNCTION is not set
# CONFIG_ARCH_BUTTONS is not set
CONFIG_ESPRESSIF_I2C0=y
CONFIG_ESPRESSIF_I2C0_SCLPIN=1
CONFIG_ESPRESSIF_I2C0_SDAPIN=0
CONFIG_I2C_RESET=y
CONFIG_AUDIO=y
CONFIG_AUDIO_FORMAT_PCM=y
CONFIG_AUDIO_FORMAT_RAW=y
CONFIG_AUDIO_DRIVER_SPECIFIC_BUFFERS=y
CONFIG_ESP32S31_I2S=y
CONFIG_ESP32S31_I2S_DUPLEX=y
CONFIG_ESP32S31_KORVO_AUDIO=y
CONFIG_ESP32S31_KORVO_PCM_STOP_MS=2000
CONFIG_SYSTEM_NXLOOPER=y
CONFIG_NXLOOPER_MAINTHREAD_STACKSIZE=4096
CONFIG_NXLOOPER_LOOPTHREAD_STACKSIZE=4096
CONFIG_PTHREAD_STACK_MIN=4096
