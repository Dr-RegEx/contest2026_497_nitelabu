# MCPWM GPIO37 output/capture loopback on the onboard LED input.
#include "../xts-flat-rtc/defconfig"

CONFIG_ESP32S31_BOARD_KORVO=y
CONFIG_PWM=y
CONFIG_CAPTURE=y
CONFIG_ESP32S31_MCPWM=y
CONFIG_ESP32S31_MCPWM_PWM_PIN=37
CONFIG_ESP32S31_MCPWM_CAPTURE_PIN=37
CONFIG_ESP32S31_MCPWM_LOOPBACK_TEST=y
CONFIG_NSH_QUOTE=y
CONFIG_UART0_RXBUFSIZE=256
# CONFIG_NSH_ARGCAT is not set
# CONFIG_NSH_NETINIT is not set
# CONFIG_ESP_RMT is not set
CONFIG_ESP32S31_MCPWM_TRACE=y
