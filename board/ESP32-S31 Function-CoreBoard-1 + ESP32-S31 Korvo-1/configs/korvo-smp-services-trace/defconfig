# Diagnostic variant of the maintained SMP service image.
# Trace the ELF loader without changing cache, scheduler or service behavior.
# Logging changes timing; this profile is not production qualification.
#include "../korvo-smp-services/defconfig"

CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_WARN=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_BINFMT=y
CONFIG_DEBUG_BINFMT_ERROR=y
CONFIG_DEBUG_BINFMT_WARN=y
CONFIG_DEBUG_BINFMT_INFO=y
