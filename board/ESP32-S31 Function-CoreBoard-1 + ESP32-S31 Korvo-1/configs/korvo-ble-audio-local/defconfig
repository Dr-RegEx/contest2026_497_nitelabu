# Local LE Audio controller qualification on Korvo through the persistent
# framework owner. The Mesh shell exposes the existing ISO and BAP commands.
# No scan, advertisement, connection or audio stream starts automatically.
# Peer interoperability and the framework LE Audio profile service are separate.
#include "../korvo-ble-mesh-service/defconfig"

CONFIG_BT_AUDIO=y
CONFIG_BT_ISO_PERIPHERAL=y
CONFIG_BT_ISO_CENTRAL=y
CONFIG_BT_ISO_BROADCASTER=y
CONFIG_BT_ISO_SYNC_RECEIVER=y
CONFIG_BT_BAP_UNICAST_SERVER=y
CONFIG_BT_BAP_UNICAST_CLIENT=y
CONFIG_BT_BAP_BROADCAST_SOURCE=y
CONFIG_BT_BAP_BROADCAST_SINK=y
CONFIG_BT_ASCS=y
CONFIG_BT_PACS=y
CONFIG_BT_BAP_SCAN_DELEGATOR=y
CONFIG_BT_ATT_PREPARE_COUNT=2
CONFIG_LIB_LC3=y
CONFIG_BT_ISO_TX_BUF_COUNT=4
