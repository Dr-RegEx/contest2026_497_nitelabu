# LP UART internal loopback, with no external pin assignment.
#include "../xts-flat-rtc/defconfig"

CONFIG_ESP32S31_BOARD_KORVO=y
CONFIG_ESP32S31_LPUART=y
CONFIG_ESP32S31_LPUART_LOOPBACK=y
CONFIG_ESP32S31_LPUART_LOOPBACK_TEST=y
CONFIG_SERIAL_TERMIOS=y
CONFIG_NSH_QUOTE=y
CONFIG_UART0_RXBUFSIZE=256
# CONFIG_NSH_ARGCAT is not set
# CONFIG_NSH_NETINIT is not set
