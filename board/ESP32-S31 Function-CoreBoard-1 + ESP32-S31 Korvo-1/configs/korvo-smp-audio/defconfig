# S-mode SMP audio through the standard ALSA API. Generated playback only.
# Applications are embedded in the kernel's ROMFS; no external AppFS is used.
#include "../smp/defconfig"
CONFIG_ESP32S31_BOARD_KORVO=y
# CONFIG_ESP32S31_BOARD_FUNCTION is not set
CONFIG_ARCH_SHM_VBASE=0x62000000
CONFIG_ARCH_SHM_NPAGES=1024
CONFIG_AUDIO=y
CONFIG_AUDIO_FORMAT_PCM=y
CONFIG_AUDIO_FORMAT_RAW=y
CONFIG_AUDIO_PROCESS_OWNERSHIP=y
CONFIG_AUDIO_DRIVER_SPECIFIC_BUFFERS=y
CONFIG_ESPRESSIF_I2C0=y
CONFIG_ESPRESSIF_I2C0_SCLPIN=1
CONFIG_ESPRESSIF_I2C0_SDAPIN=0
CONFIG_I2C_RESET=y
CONFIG_ESP32S31_I2S=y
CONFIG_ESP32S31_I2S_DUPLEX=y
CONFIG_ESP32S31_I2S_DUPLEX_WORKER_PRIORITY=253
CONFIG_ESP32S31_I2S_DUPLEX_DMA_SLOTS=8
CONFIG_ESP32S31_KORVO_AUDIO=y
CONFIG_ESP32S31_KORVO_PCM_STOP_MS=2000
CONFIG_AUDIOUTILS_ALSA_LIB=y
CONFIG_AUDIOUTILS_ALSA_LIB_DEVICE_HW=y
CONFIG_AUDIOUTILS_ALSA_LIB_LOG_ERR=y
CONFIG_EXAMPLES_S31PCMCHECK=y
CONFIG_PTHREAD_STACK_MIN=4096
CONFIG_DEBUG_AUDIO_ERROR=y
CONFIG_DEBUG_AUDIO_WARN=y
