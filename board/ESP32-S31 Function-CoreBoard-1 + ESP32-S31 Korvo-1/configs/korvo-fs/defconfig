#include "../korvo-network/defconfig"

# Korvo SMP/Sv32 filesystem qualification, same bounded AppFS/storage layout.
# Original testcase programs remain unchanged; s31fsbench adds committed data
# verification and separate setup/write/sync timings, not a replacement xTS.
CONFIG_TESTS_TESTCASES=y
CONFIG_TESTING_TESTCASES_STACKSIZE=32768
# The inherited aligned-TLS limit is8KiB; these original cases need32KiB.
CONFIG_TLS_LOG2_MAXSTACK=15
# ROMFS must retain full testcase and .sha256 names (up to54 bytes).
# LittleFS defaults its compile-time limit to NAME_MAX; existing volume
# format limits and actual filename operations are separate checks.
CONFIG_NAME_MAX=64
CONFIG_FS_TEST=y
CONFIG_FS_TEST_STRESS=y
CONFIG_NSH_CMDOPT_DD_STATS=y
CONFIG_EXAMPLES_S31FSBENCH=y
CONFIG_EXAMPLES_S31FSBENCH_STACKSIZE=32768
CONFIG_STACK_COLORATION=y
CONFIG_SYSTEM_NSH_STACKSIZE=8192
