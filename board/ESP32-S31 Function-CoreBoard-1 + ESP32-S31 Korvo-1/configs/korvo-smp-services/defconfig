# Korvo KERNEL/SMP system services with independent native applications.
# Services start explicitly after the host verifies the paired images/mounts.
#include "../korvo-smp-display/defconfig"

CONFIG_HAVE_CXX=y
CONFIG_LIBCXX=y
CONFIG_LIBCXXABI=y
CONFIG_LIBC_LOCALE=y
CONFIG_CXX_LOCALIZATION=y
CONFIG_FS_LARGEFILE=y
CONFIG_TIMER_FD=y
CONFIG_DRIVERS_BINDER=y
CONFIG_BINDER_HEAP_SIZE=65536
# CONFIG_KVDB_DIRECT is not set
CONFIG_KVDB_SERVER=y
CONFIG_KVDB_STACKSIZE=8192
CONFIG_ANDROID_BINDER=y
# CONFIG_ANDROID_BINDER_RPC is not set
CONFIG_ANDROID_SERVICEMANAGER=y
# CONFIG_ANDROID_SERVICEMANAGER_INPROC is not set
CONFIG_ANDROID_SERVICEMANAGER_STACKSIZE=16384
CONFIG_NET_IPv4=y
CONFIG_NETDEV_IFINDEX=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NETDB_DNSCLIENT=y
# CONFIG_NSH_NETINIT is not set
# CONFIG_ESPRESSIF_WIFI is not set
# CONFIG_ESP32S31_BLE is not set


CONFIG_GRAPHICS_LVGL=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_NUTTX=y
CONFIG_LV_USE_NUTTX_TOUCHSCREEN=y
CONFIG_LV_USE_NUTTX_LIBUV=y
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_LV_USE_DEMO_MUSIC=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LIBC_REGEX=y
CONFIG_TLS_NELEM=8
CONFIG_TLS_TASK_NELEM=8
# Per-process FreeType rendering stacks need >32 KiB; aligned TLS must fit.
CONFIG_TLS_LOG2_MAXSTACK=16
CONFIG_FS_SHMFS=y
CONFIG_LIBUV=y
CONFIG_LIBUV_EXTENSION=y
CONFIG_LIB_ZLIB=y
CONFIG_CRYPTO_MBEDTLS=y
CONFIG_LIBASH=y
CONFIG_LIB_RAPIDJSON=y
CONFIG_UIKIT=y
CONFIG_KVDB_TEMPORARY_STORAGE=y
CONFIG_KVDB_PERSIST_PATH="/data/persist"
CONFIG_SYSTEM_SERVER=y
CONFIG_SYSTEM_SERVER_LITE=n
CONFIG_SYSTEM_SERVER_APP_STACKSIZE=36864
CONFIG_SYSTEM_SERVER_STACKSIZE=36864
CONFIG_SYSTEM_PACKAGE_SERVICE=y
CONFIG_SYSTEM_PACKAGE_SERVICE_TASK_TIMEOUT_MS=60000
CONFIG_SYSTEM_PACKAGE_SERVICE_COMMAND=y
CONFIG_SYSTEM_WINDOW_SERVICE=y
CONFIG_SYSTEM_ACTIVITY_SERVICE=y
CONFIG_AM_COMMAND=y
CONFIG_XMSDEMO_LAUNCHER=y
CONFIG_XMSDEMO_LVGLDEMO=y
CONFIG_XMSDEMO_PLATFORM=y
CONFIG_XMSDEMO_PLATFORM_MEDIA=y
CONFIG_ESP32S31_KORVO_SMP_HMI_QUALIFICATION=y
CONFIG_EXAMPLES_S31FOUNDATION=y
# Existing E196 still preserves /apps. This candidate uses /data directly.
CONFIG_ESP32S31_FLASH_APPFS_SEED_INSTALL=n
# Measure actual linked sizes before selecting a deployable Flash layout.
CONFIG_ARCH_TEXT_NPAGES=1024
CONFIG_ELF_APP_MAX_FILESIZE=4194304
CONFIG_ELF_APP_VERIFY=y

# Use only the dependency versions already present in the locked workspace.
CONFIG_INTERPRETERS_QUICKJS=y
CONFIG_INTERPRETERS_QUICKJS_STACKSIZE=32768
CONFIG_PROTOBUF_C=y
CONFIG_NETUTILS_CJSON=y
CONFIG_LIB_FREETYPE=y
CONFIG_LV_USE_FREETYPE=y
# LVGL requires at least 32 KiB of usable rendering stack with FreeType.
# Include room for the NuttX task/TLS overhead in XMS Lite's shared server.
CONFIG_SYSTEM_SERVER_STACKSIZE=36864
CONFIG_UIKIT_FONT_MANAGER=y
# UIKit appends /font to this base path.
CONFIG_UIKIT_FONT_LIB_PATH="/data/"
CONFIG_LIB_YOGA=y
CONFIG_LIB_PNG=y
CONFIG_LV_USE_LIBPNG=y
CONFIG_LIB_CURL=y
CONFIG_UTILS_CURL=y
# Mbed TLS getrandom(0) and curl require the architecture RNG device here.
CONFIG_DEV_URANDOM=y
CONFIG_DEV_URANDOM_ARCH=y
# Synchronization is requested explicitly after a network connection.
CONFIG_SYSTEM_NTPC=y
# CONFIG_NETUTILS_NTPCLIENT_STAY_ON is not set
CONFIG_FEATURE_FRAMEWORK=y
# The local tree has no matching RISC-V quickapp core. Keep the runtime off.
# CONFIG_QUICKAPP is not set
# CONFIG_FRAMEWORK_ENABLE_LOG is not set

# Device/service Feature modules need individual runtime/API qualification;
# do not enable every default. The upstream mandatory exchange choice selects
# its C++ implementation; keep that choice explicit, without claiming a pass.
# CONFIG_FEATURE_SYSTEM_SENSOR is not set
# CONFIG_FEATURE_SYSTEM_FILE is not set
# CONFIG_FEATURE_SYSTEM_MEDIA is not set
# CONFIG_FEATURE_SYSTEM_REQUEST is not set
# CONFIG_FEATURE_SYSTEM_ZIP is not set
# CONFIG_FEATURE_SYSTEM_CRYPTO is not set
# CONFIG_FEATURE_SYSTEM_CIPHER is not set
# CONFIG_FEATURE_SYSTEM_VIBRATOR is not set
# CONFIG_FEATURE_SYSTEM_INTERNAL_POWER is not set
# CONFIG_FEATURE_SYSTEM_INTERNAL_ACTIVITY is not set
# CONFIG_FEATURE_SYSTEM_PACKAGEMANAGER is not set
# CONFIG_FEATURE_SYSTEM_TEST_INPUT is not set
# CONFIG_FEATURE_SYSTEM_FETCH is not set
# CONFIG_FEATURE_SYSTEM_PROMPT is not set
# CONFIG_FEATURE_SYSTEM_MESSAGECHANNEL is not set
CONFIG_FEATURE_SYSTEM_EXCHANGE=y
# CONFIG_FEATURE_SYSTEM_CONFIGURATION is not set
# CONFIG_FEATURE_SYSTEM_DEVICE is not set
# CONFIG_FEATURE_SYSTEM_BRIGHTNESS is not set
# CONFIG_FEATURE_SYSTEM_EVENT is not set
# CONFIG_FEATURE_SYSTEM_EVENT_TEST is not set
# CONFIG_FEATURE_SYSTEM_STORAGE is not set
# CONFIG_FEATURE_SERVICE_WECHAT is not set
# CONFIG_FEATURE_LOCALE is not set
# CONFIG_FEATURE_ERROR is not set
# CONFIG_FEATURE_SYSTEM_BATTERY is not set
# CONFIG_FEATURE_SYSTEM_GEOLOCATION is not set
# CONFIG_FEATURE_SERVICE_HEALTH is not set
# CONFIG_FEATURE_SYSTEM_INTERCONNECT is not set
# CONFIG_FEATURE_SYSTEM_ZLIB is not set
# CONFIG_FEATURE_SYSTEM_MQTTMESSAGE is not set
# CONFIG_FEATURE_INPUT_METHOD_CONTROLLER is not set


# Required by the actual RISC-V setjmp consumers (PNG/FreeType).
CONFIG_ARCH_SETJMP_H=y

# Bound initial per-process reservations while retaining checked heap growth.
CONFIG_ARCH_HEAP_INITIAL_NPAGES=16
CONFIG_SYSTEM_WINDOW_DEFAULT_RGB565=y
# CONFIG_INTERPRETERS_QUICKJS_MINI is not set
CONFIG_INTERPRETERS_QUICKJS_NONE=y
CONFIG_SCHED_CHILD_STATUS=y
CONFIG_PREALLOC_CHILDSTATUS=0
CONFIG_SYSTEM_NSH_STACKSIZE=8192
CONFIG_FS_HEAPLARGE_ONLY=y
CONFIG_FS_HEAP_MEMPOOL_INIT_CHUNK_SIZE=0

# 16 MiB flash: boot/kernel [0,2MiB), read-only apps [2,14MiB), data [14,16MiB).
CONFIG_ESP32S31_FLASH_APPFS=y
# CONFIG_INIT_MOUNT is not set
CONFIG_ESPRESSIF_STORAGE_MTD_OFFSET=0x200000
CONFIG_ESPRESSIF_STORAGE_MTD_SIZE=0xe00000
CONFIG_ESP32S31_FLASH_APPFS_SEED_SIZE=0xc00000
# CONFIG_ESP32S31_FLASH_APPFS_SEED_INSTALL is not set
# CONFIG_EXAMPLES_S31FBCHECK is not set
# CONFIG_EXAMPLES_S31PCMCHECK is not set
# CONFIG_EXAMPLES_S31MEDIACHECK is not set
# CONFIG_MEDIA_TOOL is not set
