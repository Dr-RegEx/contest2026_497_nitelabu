# Native openvela port of the Espressif Korvo factory application.
# Preserve the separately qualified SMP/vision and wireless profiles.
#include "../korvo-openvela-media-demo/defconfig"

# Use the existing single-core native services and qualified peripheral paths.
CONFIG_XMSDEMO_FACTORY=y
# CONFIG_XMSDEMO_PLATFORM is not set
# CONFIG_XMSDEMO_PLATFORM_MEDIA is not set
# CONFIG_XMSDEMO_LVGLDEMO is not set
# CONFIG_LV_USE_DEMO_WIDGETS is not set
# CONFIG_LV_USE_DEMO_MUSIC is not set
# CONFIG_EXAMPLES_S31PREVIEW is not set
# CONFIG_EXAMPLES_TOUCHSCREEN is not set
# CONFIG_EXAMPLES_S31MEDIACHECK is not set

# The original factory dashboard has no wireless operation. Its physical keys
# use the isolated ADC ladder; do not bypass the ADC/RF sharing restrictions.
# CONFIG_ESPRESSIF_WIFI is not set
# CONFIG_ESP32S31_BLE is not set
# CONFIG_ESPRESSIF_TEMP is not set
# CONFIG_NSH_NETINIT is not set

# Camera and SDMMC are inherited from the native Korvo graphics base.
CONFIG_ESP32S31_CAMERA_OV3660=y
CONFIG_ESP32S31_CAMERA_DVP=y
CONFIG_ESP32S31_CAMERA_V4L2=y
CONFIG_ESP32S31_SDMMC=y
CONFIG_ESP32S31_SDMMC_IDF_HOST=y
CONFIG_MMCSD_MULTIBLOCK_LIMIT=16
CONFIG_FS_FAT=y
CONFIG_FAT_LFN=y
CONFIG_FAT_MAXFNAME=64
CONFIG_FAT_LCNAMES=y

# Four physical ladder keys and the onboard RMT-driven RGB status LED.
CONFIG_SCHED_LPWORK=y
CONFIG_ESP32S31_KORVO_ADC_BUTTONS=y
CONFIG_RMT=y
CONFIG_ESP_RMT=y
CONFIG_WS2812=y
CONFIG_WS2812_NON_SPI_DRIVER=y
CONFIG_WS2812_LED_COUNT=1

# Native USB host keyboard/mouse input; do not enable device mode.
CONFIG_USBHOST=y
CONFIG_ESP32S31_USBHOST=y
CONFIG_ESP32S31_USBHOST_HCD_SKELETON=y
CONFIG_USBHOST_ASYNCH=y
CONFIG_USBHOST_HID=y
CONFIG_USBHOST_HIDKBD=y
CONFIG_USBHOST_HIDMOUSE=y
CONFIG_HIDKBD_NOGETREPORT=y

# Native LVGL decoding of the original transparent PNG resources in the embedded ROM filesystem.
CONFIG_LIB_PNG=y
CONFIG_LV_USE_LIBPNG=y
CONFIG_LV_USE_THEME_SIMPLE=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_46=y
CONFIG_LIB_ZLIB=y
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=83
CONFIG_LV_FS_POSIX_PATH=""
CONFIG_LV_FS_POSIX_CACHE_SIZE=0
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LV_DRAW_BUF_STRIDE_ALIGN=1
CONFIG_LV_DRAW_BUF_ALIGN=4
CONFIG_LV_CACHE_DEF_SIZE=2097152
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=48
CONFIG_LV_DECODER_IMG_SIZE_EXPAND=0

# Native MEDIA Capture and Music graphs use bounded 16-bit PCM sessions.
CONFIG_LIB_FFMPEG_CONFIGURATION="--disable-asm --disable-inline-asm --disable-rvv --disable-tx-double --disable-tx-int32 --enable-avcodec --enable-avdevice --enable-avfilter --enable-avformat --enable-swresample --enable-alsa --enable-decoder='aac,mp3float,opus,pcm_s16le' --enable-encoder=pcm_s16le --enable-demuxer='aac,mov,mp3,ogg,wav,pcm_s16le' --enable-muxer=pcm_s16le --enable-parser='aac,mpegaudio,opus' --enable-filter='abufsrc,asubgraph,abuffer,abuffersink,aresample,alsasink,alsasrc,abufsink' --enable-protocol=file,unix --enable-hardcoded-tables"
