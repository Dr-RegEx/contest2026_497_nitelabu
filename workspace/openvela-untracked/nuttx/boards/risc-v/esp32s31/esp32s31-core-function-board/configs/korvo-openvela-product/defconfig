# Korvo native HMI product integration: persistent state first, connection next.
# This remains single-core FLAT; do not merge KERNEL/AppFS throughput overlays.
#include "../korvo-openvela-hmi/defconfig"

CONFIG_ESP32S31_KORVO_HMI_DATA=y
CONFIG_ESP32S31_HMI_DATA_OFFSET=0xe00000
CONFIG_ESP32S31_HMI_DATA_SIZE=0x100000
CONFIG_ESPRESSIF_SPIFLASH_MTD_BLKSIZE=512
CONFIG_FS_LITTLEFS_READ_SIZE_FACTOR=1
CONFIG_FS_LITTLEFS_PROGRAM_SIZE_FACTOR=4
CONFIG_FS_LITTLEFS_BLOCK_SIZE_FACTOR=1
CONFIG_FS_LITTLEFS_CACHE_SIZE_FACTOR=8
CONFIG_FS_LITTLEFS_LOOKAHEAD_SIZE=0
CONFIG_FS_LITTLEFS_BLOCK_CYCLE=200
CONFIG_FS_LITTLEFS_NAME_MAX=64
CONFIG_FS_LITTLEFS_FILE_MAX=2147483647
CONFIG_FS_LITTLEFS_ATTR_MAX=1022
CONFIG_FS_LITTLEFS_ATTR_UPDATE=y
CONFIG_NAME_MAX=64
CONFIG_FS_HEAPSIZE=0
CONFIG_ESP32S31_FLASH_STAGING_BYTES=256

# FS_LITTLEFS_COALESCE requires KERNEL/MMU page-pool mapping and is inapplicable
# to this FLAT profile. The qualified FS/network profiles remain unchanged.
