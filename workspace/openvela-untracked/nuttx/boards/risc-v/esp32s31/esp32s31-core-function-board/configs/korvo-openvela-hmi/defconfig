# Korvo-1 / SUB3 standard graphics and XMS service integration candidate.
# Keep the existing display/camera/touch/SD qualification profile intact.
# This profile is FLAT and single-core until the LCD KERNEL/SMP path is ready.
#include "../korvo-touch-xts/defconfig"

CONFIG_TESTING_CMOCKA=n
CONFIG_TESTING_DRIVER_TEST=n

CONFIG_HAVE_CXX=y
CONFIG_LIBCXX=y
CONFIG_LIBCXXABI=y
CONFIG_LIBC_LOCALE=y
CONFIG_CXX_LOCALIZATION=y
CONFIG_TLS_NELEM=8
CONFIG_TLS_TASK_NELEM=4
CONFIG_EVENT_FD=y
CONFIG_TIMER_FD=y
CONFIG_FS_LARGEFILE=y
CONFIG_FS_SHMFS=y
CONFIG_FS_TMPFS=y
CONFIG_FS_BINFS=y
CONFIG_FS_ROMFS=y
CONFIG_ETC_ROMFS=y
CONFIG_BINFMT_DISABLE=n
CONFIG_PATH_INITIAL="/system/bin"
CONFIG_STACK_COLORATION=y

CONFIG_NET=y
# Local service IPC does not need an early hardware network driver.
CONFIG_NETDEV_LATEINIT=y
CONFIG_NSH_NETINIT=n
CONFIG_NET_LOCAL=y
CONFIG_NET_LOCAL_STREAM=y

CONFIG_DRIVERS_BINDER=y
CONFIG_ANDROID_BINDER=y
CONFIG_ANDROID_SERVICEMANAGER=y
CONFIG_LIBUV=y
CONFIG_LIBUV_EXTENSION=y
CONFIG_LIB_ZLIB=y
CONFIG_CRYPTO_MBEDTLS=y
CONFIG_LIBASH=y
CONFIG_LIB_RAPIDJSON=y
CONFIG_UIKIT=y
CONFIG_KVDB=y
CONFIG_KVDB_SERVER=y
CONFIG_KVDB_STACKSIZE=8192
CONFIG_KVDB_FILE=y
CONFIG_KVDB_PERSIST_PATH="/data/persist"
CONFIG_KVDB_TEMPORARY_STORAGE=y
CONFIG_LV_USE_NUTTX_LIBUV=y

CONFIG_SYSTEM_SERVER=y
CONFIG_SYSTEM_SERVER_LITE=y
CONFIG_SCHED_HAVE_PARENT=y
CONFIG_SCHED_CHILD_STATUS=y
CONFIG_SCHED_WAITPID=y
CONFIG_SIG_DEFAULT=y
CONFIG_SIG_SIGKILL_ACTION=y
CONFIG_SYSTEM_PACKAGE_SERVICE=y
CONFIG_SYSTEM_PACKAGE_SERVICE_TASK_TIMEOUT_MS=60000
CONFIG_SYSTEM_PACKAGE_SERVICE_COMMAND=y
CONFIG_SYSTEM_PACKAGE_SERVICE_TMPFS_RESERVE=262144
CONFIG_SYSTEM_WINDOW_SERVICE=y
CONFIG_SYSTEM_ACTIVITY_SERVICE=y
CONFIG_AM_COMMAND=y
CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_DEMO_MUSIC=y
CONFIG_XMSDEMO_LVGLDEMO=y
CONFIG_XMSDEMO_LAUNCHER=y
CONFIG_ESP32S31_KORVO_HMI=y
