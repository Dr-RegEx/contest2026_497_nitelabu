# Production FS choices, shared by explicit integration profiles only.
# Preserve the maintained Korvo partition/security/explicit association policy.
CONFIG_ESPRESSIF_SPIFLASH_MTD_BLKSIZE=512
CONFIG_FS_LITTLEFS=y
CONFIG_FS_LITTLEFS_READ_SIZE_FACTOR=1
CONFIG_FS_LITTLEFS_PROGRAM_SIZE_FACTOR=4
CONFIG_FS_LITTLEFS_BLOCK_SIZE_FACTOR=1
CONFIG_FS_LITTLEFS_CACHE_SIZE_FACTOR=8
CONFIG_FS_LITTLEFS_LOOKAHEAD_SIZE=0
CONFIG_FS_LITTLEFS_BLOCK_CYCLE=200
CONFIG_NAME_MAX=64
CONFIG_FS_LITTLEFS_NAME_MAX=64
CONFIG_FS_LITTLEFS_FILE_MAX=2147483647
CONFIG_FS_LITTLEFS_ATTR_MAX=1022
CONFIG_FS_LITTLEFS_ATTR_UPDATE=y
CONFIG_FS_HEAPSIZE=0
CONFIG_STDIO_BUFFER_SIZE=64
CONFIG_NUNGET_CHARS=2
CONFIG_MM_PGSIZE=4096
CONFIG_MM_PGALLOC=y
CONFIG_ARCH_PGPOOL_MAPPING=y
CONFIG_ARCH_PGPOOL_PBASE=0x50000000
CONFIG_ARCH_PGPOOL_VBASE=0x50000000
CONFIG_ARCH_PGPOOL_SIZE=16777216
CONFIG_FS_LITTLEFS_COALESCE=y
CONFIG_ESP32S31_FLASH_STAGING_BYTES=256
# CONFIG_ESP32S31_FLASH_DIAGNOSTICS is not set
