# CAN0 GPIO37 loopback; no external wire or transceiver required.
#include "../xts-flat-rtc/defconfig"

CONFIG_ESP32S31_BOARD_KORVO=y
CONFIG_CAN=y
CONFIG_CAN_FD=y
CONFIG_CAN_EXTID=y
CONFIG_CAN_USE_RTR=y
CONFIG_CAN_LOOPBACK=y
CONFIG_CAN_RXFIFOSIZE=16
CONFIG_ESP32S31_CANFD=y
CONFIG_ESP32S31_CANFD_TX_PIN=37
CONFIG_ESP32S31_CANFD_RX_PIN=37
CONFIG_ESP32S31_CANFD_LOOPBACK_TEST=y
CONFIG_NSH_QUOTE=y
CONFIG_UART0_RXBUFSIZE=256
