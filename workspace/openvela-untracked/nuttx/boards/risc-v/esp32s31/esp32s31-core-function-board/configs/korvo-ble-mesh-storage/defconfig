# Local identity persistence qualification; no automatic network startup.
#include "../korvo-ble-mesh-local/defconfig"

# Keep the default controller identity and one synthetic test identity.
CONFIG_DRIVERS_WIRELESS=y
# Concurrent scanning/initiating restricts the upstream host to one identity.
# CONFIG_BT_SCAN_AND_INITIATE_IN_PARALLEL is not set
CONFIG_BT_EXT_ADV=y
CONFIG_BT_ID_MAX=2
CONFIG_NETUTILS_CODECS=y
CONFIG_CODECS_HASH_MD5=y
# CONFIG_NSH_NETINIT is not set
