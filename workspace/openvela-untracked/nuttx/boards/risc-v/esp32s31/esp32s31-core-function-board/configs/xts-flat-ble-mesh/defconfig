# Isolated ZBlue Bluetooth Mesh build candidate.  No peer node is needed for
# this compile check; provisioning and model traffic still require a second
# device and are not claimed here.
#include "../xts-flat-bttool/defconfig"

CONFIG_BT_MESH=y
# The flat ZBlue port supplies this stack to pthread_attr_setstack().
# Match the 4096-byte PTHREAD_STACK_MIN inherited from xts-flat-ble.
CONFIG_BT_MESH_ADV_STACK_SIZE=4096
CONFIG_BT_MESH_PB_ADV=y
CONFIG_BT_MESH_PB_GATT=y
CONFIG_BT_MESH_PROVISIONEE=y
CONFIG_BT_MESH_RELAY=y
CONFIG_BT_MESH_RELAY_ENABLED=y
CONFIG_BT_MESH_GATT_PROXY=y
