config XMSDEMO_FACTORY
	tristate "ESP32-S31 Korvo native factory demo"
	default n
	depends on SYSTEM_SERVER && SYSTEM_ACTIVITY_SERVICE
	depends on SYSTEM_WINDOW_SERVICE && SYSTEM_PACKAGE_SERVICE
	depends on UIKIT && GRAPHICS_LVGL
	depends on LV_COLOR_DEPTH_16
	depends on LV_USE_CANVAS && LV_USE_IMAGE && LV_USE_LABEL
	depends on LV_USE_BUTTON && LV_USE_SLIDER && LV_USE_ROLLER && LV_USE_BAR
	depends on LV_USE_ARC && LV_USE_DROPDOWN && LV_USE_TEXTAREA
	depends on LV_USE_KEYBOARD && LV_USE_SPINBOX
	depends on LV_USE_THEME_SIMPLE
	depends on LV_FONT_MONTSERRAT_14 && LV_FONT_MONTSERRAT_18 && LV_FONT_MONTSERRAT_24 && LV_FONT_MONTSERRAT_46
	help
		Native Activity/Window port of the pinned Espressif factory demo.
		Requires native backend and coffee asset provider targets supplied by
		the platform integration. Does not configure hardware or ESP-IDF.
