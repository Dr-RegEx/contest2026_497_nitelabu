#
# JPEG/RGB software smoke test for the S31 board.
#

config EXAMPLES_JPEGTEST
	tristate "JPEG and RGB pixel-format test"
	default n
	depends on LIB_JPEG_TURBO
	---help---
		Enable the jpegtest command.  It encodes synthetic RGB888 images,
		checks decoded RGB888 pixels and RGB565 conversion, and rejects
		truncated inputs.  Optional width, height and repeat arguments
		exercise product sizes without camera capture or filesystem I/O.

if EXAMPLES_JPEGTEST

config EXAMPLES_JPEGTEST_PROGNAME
	string "Program name"
	default "jpegtest"

config EXAMPLES_JPEGTEST_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_JPEGTEST_STACKSIZE
	int "Task stack size"
	default 8192

endif
