+            if (errno == EINTR)
+                continue;
+            return AVERROR(errno);
+        }
+        if (!ret)
+            return AVERROR(EPIPE);
+        priv->drain_offset += ret;
+    }
+    priv->drain_pending = false;
+    if (!priv->discard_requested) {
+        if (!priv->discard_offset) {
+            priv->discard_target = priv->written_bytes;
+            priv->discard_request[0] = BLUELET_CTRL_CMD_DISCARD;
+            AV_WL64(priv->discard_request + 1, priv->discard_target);
+        }
+        while (priv->discard_offset < sizeof(priv->discard_request)) {
+            ret = send(priv->ctrl_fd, priv->discard_request + priv->discard_offset,
+                       sizeof(priv->discard_request) - priv->discard_offset, MSG_NOSIGNAL);
+            if (ret < 0) {
+                if (errno == EINTR)
+                    continue;
+                return AVERROR(errno);
+            }
+            if (!ret)
