+static int media_recorder_plugin_uninit(MediadPlugin* plugin)
+{
+    MediaRecorderPriv* priv = plugin->priv;
+    int i, ret;
+
+    for (i = 0; i < CONFIG_MEDIA_RECORDER_MAX_CNT; i++) {
+        ret = media_recorder_join(&priv->ctxs[i]);
