+static int media_recorder_plugin_init(MediadPlugin* plugin)
+{
+    MediaRecorderPriv* priv = plugin->priv;
+    int i, ret;
+
+    ret = pthread_mutex_init(&priv->lifecycle_lock, NULL);
+    if (ret)
+        return -ret;
+    priv->completed_fd = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+    if (priv->completed_fd < 0) {
+        ret = -errno;
+        pthread_mutex_destroy(&priv->lifecycle_lock);
+        return ret;
+    }
+    for (i = 0; i < CONFIG_MEDIA_RECORDER_MAX_CNT; i++)
+        priv->ctxs[i].owner = priv;
+    return 0;
+}
+
+static void media_recorder_request_stop(MediadPlugin* plugin)
+{
+    MediaRecorderPriv* priv = plugin->priv;
+    uint64_t count = 1;
