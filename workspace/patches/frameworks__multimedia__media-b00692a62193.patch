+    priv->stopping = true;
+    pthread_mutex_lock(&priv->lifecycle_lock);
+    for (i = 0; i < CONFIG_MEDIA_RECORDER_MAX_CNT; i++) {
+        MediaRecorderContext* ctx = &priv->ctxs[i];
+        if (ctx->state == MEDIA_RECORDER_STATE_IDLE)
+            continue;
+        ctx->cancel_requested = true;
+        do {
+            ret = write(ctx->event_fd, &count, sizeof(count));
+        } while (ret < 0 && errno == EINTR);
+    }
+    pthread_mutex_unlock(&priv->lifecycle_lock);
