+int lfs_file_identity(lfs_t *lfs, const char *path,
+        lfs_block_t pair[2], uint16_t *id) {
+    int err = LFS_LOCK(lfs->cfg);
+    if (err) {
+        return err;
+    }
+    lfs_mdir_t dir;
+    lfs_stag_t tag = lfs_dir_find(lfs, &dir, &path, id);
+    if (tag < 0) {
+        err = tag;
+    } else if (lfs_tag_type3(tag) != LFS_TYPE_REG) {
+        err = LFS_ERR_ISDIR;
+    } else {
+        pair[0] = dir.pair[0];
+        pair[1] = dir.pair[1];
+        err = 0;
+    }
+    LFS_UNLOCK(lfs->cfg);
+    return err;
+}
