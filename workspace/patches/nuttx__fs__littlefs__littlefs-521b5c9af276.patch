+int lfs_file_commit_updates(lfs_t *lfs, lfs_file_t *file,
+        const struct lfs_update_range *ranges, lfs_size_t count) {
+    int err = LFS_LOCK(lfs->cfg);
+    if (err) {
+        return err;
+    }
+    LFS_ASSERT(lfs_mlist_isopen(lfs->mlist, (struct lfs_mlist*)file));
+    err = lfs_file_rawcommit_updates(lfs, file, ranges, count);
+    LFS_UNLOCK(lfs->cfg);
+    return err;
+}
