+static int lfs_file_rawcommit_updates(lfs_t *lfs, lfs_file_t *file,
+        const struct lfs_update_range *ranges, lfs_size_t count) {
+    // Validation precedes all mutation. A clean committed CTZ is the source
+    // for every unchanged byte; accepting another handle's stale CTZ here
+    // would be incorrect, so VFS must provide a single shared file identity.
+    if (file->flags & LFS_F_ERRED) {
+        return LFS_ERR_IO;
+    }
+    if ((file->flags & LFS_O_WRONLY) != LFS_O_WRONLY) {
+        return LFS_ERR_BADF;
+    }
+    if (!count) {
+        return 0;
+    }
+    if (!ranges || (file->flags & (LFS_F_DIRTY | LFS_F_WRITING |
+            LFS_F_INLINE | LFS_O_APPEND))) {
+        return LFS_ERR_INVAL;
+    }
+    lfs_off_t last = 0;
+    for (lfs_size_t i = 0; i < count; i++) {
+        if (!ranges[i].buffer || !ranges[i].size || ranges[i].off < last ||
+                ranges[i].off > file->ctz.size ||
+                ranges[i].size > file->ctz.size-ranges[i].off) {
+            return LFS_ERR_INVAL;
+        }
+        last = ranges[i].off + ranges[i].size;
+    }
+
+    // A no-op seek does not clear LFS_F_READING. Clear it explicitly before
+    // handing the same cache to the flushed writer.
+    int err = lfs_file_flush(lfs, file);
+    if (err) {
+        return err;
+    }
+    lfs_off_t saved = file->pos;
+    lfs_soff_t res = lfs_file_rawseek(lfs, file, ranges[0].off, LFS_SEEK_SET);
+    if (res < 0) {
+        return res;
+    }
+
+    // Exactly the same read-cache borrowing rule as lfs_file_flush's suffix
+    // copy. The old CTZ remains reachable through file->ctz until that flush
+    // completes, and through committed directory metadata until commit.
+    lfs_file_t orig = {
+        .ctz = file->ctz,
+        .flags = LFS_O_RDONLY,
+        .pos = file->pos,
+        .cache = lfs->rcache,
+    };
+    lfs_cache_drop(lfs, &lfs->rcache);
+    for (lfs_size_t i = 0; i < count; i++) {
+        while (file->pos < ranges[i].off) {
+            uint8_t data[256];
+            lfs_size_t n = lfs_min(sizeof(data), ranges[i].off-file->pos);
+            res = lfs_file_flushedread(lfs, &orig, data, n);
+            if (res < 0) {
+                err = res;
+                goto fail;
+            }
+            res = lfs_file_flushedwrite(lfs, file, data, n);
+            if (res < 0) {
+                err = res;
+                goto fail;
+            }
+            if (lfs->rcache.block != LFS_BLOCK_NULL) {
+                lfs_cache_drop(lfs, &orig.cache);
+                lfs_cache_drop(lfs, &lfs->rcache);
+            }
+        }
+        res = lfs_file_flushedwrite(lfs, file,
+                ranges[i].buffer, ranges[i].size);
+        if (res < 0) {
+            err = res;
+            goto fail;
+        }
+        if (lfs->rcache.block != LFS_BLOCK_NULL) {
+            lfs_cache_drop(lfs, &orig.cache);
+            lfs_cache_drop(lfs, &lfs->rcache);
+        }
+        res = lfs_file_rawseek(lfs, &orig, file->pos, LFS_SEEK_SET);
+        if (res < 0) {
