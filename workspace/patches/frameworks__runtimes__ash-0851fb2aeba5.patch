diff --git a/src/memory/variable_segment.cpp b/src/memory/variable_segment.cpp
index a1c05971c0e5d5d571b627385872d32535fb702e..d447e2ec4e2559abd319620b14290041db1d1f05 100644
--- a/src/memory/variable_segment.cpp
+++ b/src/memory/variable_segment.cpp
@@ -29,9 +29,10 @@ inline size_t GetAlignFromSize(size_t size) {
     return 1;
   if (size <= 2)
     return 2;
-#if defined(ASH_ARCH_32)
+#if defined(ASH_ARCH_32) && !defined(ASH_ARCH_RISCV32)
   return 4;
-#elif defined(ASH_ARCH_64)
+#elif defined(ASH_ARCH_64) || defined(ASH_ARCH_RISCV32)
+  // The RISC-V ILP32 ABI also requires 8-byte alignment for 64-bit values.
   if (size <= 4)
     return 4;
   return 8;
