-#endif
\ No newline at end of file
+typedef enum {
+    LEA_SERVER_RECEIVE_PAUSE,
+    LEA_SERVER_RECEIVE_RESUME,
+    LEA_SERVER_RECEIVE_MUTE,
+    LEA_SERVER_RECEIVE_UNMUTE,
+} lea_server_receive_control_t;
+
+typedef void (*lea_server_receive_control_callback)(void* cookie,
+    lea_server_receive_control_t control, bt_status_t status);
+
+/* Control the local, shared receive pipeline, not the remote media player or
+ * an individual ASE. Pause and mute are independent; both must be cleared to
+ * resume. Packets received while paused/muted are discarded. A stopped stream
+ * cannot be resumed with this API. Offloaded receive is not supported.
+ *
+ * SUCCESS means queued. The required callback reports the operation's result
+ * on the Bluetooth event thread, including NOT_READY after a service restart.
+ * On immediate failure no callback is made. Keep the event loop and cookie
+ * alive until completion; the callback must not block the event thread.
+ */
+bt_status_t bt_lea_server_receive_control(bt_instance_t* ins,
+    lea_server_receive_control_t control,
+    lea_server_receive_control_callback callback, void* cookie);
+
+#endif
