+{
+    PRINT("LE Audio receive control:%d completed, status:%d", control, status);
+}
+
+static int receive_control(void* handle, int argc, char* argv[])
+{
+    static const char* const names[] = { "pause", "resume", "mute", "unmute" };
+
+    if (argc != 1)
+        return CMD_USAGE_FAULT;
+
+    for (unsigned i = 0; i < ARRAY_SIZE(names); i++) {
+        if (!strcmp(argv[0], names[i])) {
+            bt_status_t status = bt_lea_server_receive_control(handle,
+                (lea_server_receive_control_t)i, receive_control_completed, NULL);
+            if (status != BT_STATUS_SUCCESS)
+                return CMD_ERROR;
+            PRINT("LE Audio receive control queued; awaiting completion");
+            return CMD_OK;
+        }
+    }
+
+    return CMD_USAGE_FAULT;
+}
