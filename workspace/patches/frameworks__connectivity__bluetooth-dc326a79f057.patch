--- a/framework/api/bt_lea_server.c
+++ b/framework/api/bt_lea_server.c
@@ -79,3 +79,19 @@ profile_connection_state_t bt_lea_server_get_connection_state(bt_instance_t* ins
 
     return profile->get_connection_state(addr);
 }
+
+bt_status_t bt_lea_server_receive_control(bt_instance_t* ins,
+    lea_server_receive_control_t control,
+    lea_server_receive_control_callback callback, void* cookie)
+{
+    lea_server_interface_t* profile;
+
+    if (control < LEA_SERVER_RECEIVE_PAUSE || control > LEA_SERVER_RECEIVE_UNMUTE || !callback)
+        return BT_STATUS_PARM_INVALID;
+
+    profile = get_profile_service();
+    if (!profile || !profile->receive_control)
+        return BT_STATUS_NOT_READY;
+
+    return profile->receive_control(control, callback, cookie);
+}
