diff --git a/launcher/CMakeLists.txt b/launcher/CMakeLists.txt
index d79265fe4b8e4d62ddc179f7552ac4256247d5e5..93117eb2f84a343c17a69b401f1bbbc33fa32ff2 100644
--- a/launcher/CMakeLists.txt
+++ b/launcher/CMakeLists.txt
@@ -19,9 +19,12 @@ if(CONFIG_XMSDEMO_LAUNCHER)
   set(CURRENT_DIR ${CMAKE_CURRENT_LIST_DIR})
   set(PROGNAME xmslauncher)
   set(CUR_TARGET xmsdemolauncher)
-  set(STACKSIZE 16384)
+  set(STACKSIZE ${CONFIG_SYSTEM_SERVER_APP_STACKSIZE})
 
-  nuttx_add_prebuilt(BIN_TARGETS ${CUR_TARGET} APP_TARGETS ${PROGNAME})
+  # Identify application sources explicitly, including source trees reached
+  # through directory symlinks, before selecting prebuilt fallback mode.
+  nuttx_add_prebuilt(BIN_TARGETS ${CUR_TARGET} APP_TARGETS ${PROGNAME}
+    GLOB_REGEX ${CURRENT_DIR}/src/*.cpp)
 
   nuttx_library_ifndef(SKIP_PREBUILT ${CUR_TARGET})
   nuttx_add_dependencies(TARGET ${CUR_TARGET} DEPENDS android_binder
@@ -35,7 +38,7 @@ if(CONFIG_XMSDEMO_LAUNCHER)
   nuttx_include_directories(${INCDIR})
 
   set(DSTPATH
-      ${NUTTX_APPS_DIR}/vendor/sim/boards/common/resource/app/${PROGNAME})
+      ${CMAKE_CURRENT_BINARY_DIR}/sim-resource/app/${PROGNAME})
   execute_process(COMMAND ${CMAKE_COMMAND} -E make_directory ${DSTPATH})
 
   execute_process(COMMAND ${CMAKE_COMMAND} -E copy ${CURRENT_DIR}/manifest.json
