     lv_obj_t * t1 = lv_tabview_add_tab(tv, "Profile");
     lv_obj_t * t2 = lv_tabview_add_tab(tv, "Analytics");
@@ -218,6 +225,7 @@ void lv_demo_widgets(void)
     shop_create(t3);
 
     color_changer_create(tv);
+    return true;
 }
 
