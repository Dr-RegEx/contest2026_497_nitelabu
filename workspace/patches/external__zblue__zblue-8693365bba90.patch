+/* Failed critical state writes must survive a cleared pending bit.  Keep
+ * retries separate from NO_WAIT_PENDING_BITS so a full/broken filesystem
+ * cannot spin the settings queue.  Each attempt serializes current state,
+ * not a stale copy of a key or sequence number.
+ */
+static void retry_pending(struct k_work *work)
+{
+	ARG_UNUSED(work);
+	for (int i = 0; i < BT_MESH_SETTINGS_FLAG_COUNT; i++) {
+		if (atomic_test_and_clear_bit(retry_flags, i)) {
+			bt_mesh_settings_store_schedule(i);
+		}
+	}
+}
+
+void bt_mesh_settings_store_result(enum bt_mesh_settings_flag flag, int err)
+{
+	if (!err) {
+		atomic_clear_bit(retry_flags, flag);
+		return;
+	}
+
+	atomic_set_bit(retry_flags, flag);
+	if (IS_ENABLED(CONFIG_BT_MESH_SETTINGS_WORKQ)) {
+		k_work_schedule_for_queue(&settings_work_q, &retry_store, K_SECONDS(1));
+	} else {
+		k_work_schedule(&retry_store, K_SECONDS(1));
+	}
+}
+
 void bt_mesh_settings_store_cancel(enum bt_mesh_settings_flag flag)
 {
 	atomic_clear_bit(pending_flags, flag);
+	atomic_clear_bit(retry_flags, flag);
 }
 
