 	}
 
 	k_work_init_delayable(&pending_store, store_pending);
+	k_work_init_delayable(&retry_store, retry_pending);
 }
 
 void bt_mesh_settings_store_pending(void)
 {
 	(void)k_work_cancel_delayable(&pending_store);
+	(void)k_work_cancel_delayable(&retry_store);
+	for (int i = 0; i < BT_MESH_SETTINGS_FLAG_COUNT; i++) {
+		if (atomic_test_and_clear_bit(retry_flags, i)) {
+			atomic_set_bit(pending_flags, i);
+		}
+	}
 
 	store_pending(&pending_store.work);
 }
