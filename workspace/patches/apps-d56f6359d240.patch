+#ifdef CONFIG_BUILD_KERNEL
+/* Blocking one-shot synchronization in this process, then ntpc_status().
+ * Requires NTPCLIENT_STAY_ON=n. Returns 0 on clock update, negative errno
+ * on failure. Async daemon start/stop return -ENOSYS in the kernel build.
+ */
+
+int ntpc_sync_with_list(FAR const char *ntp_server_list);
+#endif
+
 #undef EXTERN
 #ifdef __cplusplus
 }
diff --git a/netutils/dhcpc/dhcpc.c b/netutils/dhcpc/dhcpc.c
index bc9f09270cfda1979b62138fb32788c04c17a291..acc3edf97773916935be845fc61506f9132d7876 100644
