+
+#ifdef CONFIG_BUILD_KERNEL
+/* Keep the complete sample/update/status lifetime in the calling process.
+ * Unlike the FLAT daemon API this does not create a task or share globals
+ * with another executable. Cancellation is normal process termination.
+ */
+
+int ntpc_sync_with_list(FAR const char *ntp_server_list)
+{
+#ifdef CONFIG_NETUTILS_NTPCLIENT_STAY_ON
+  return -ENOTSUP;
+#else
+  static sem_t sync_lock = SEM_INITIALIZER(1);
+  FAR char *argv[] = {"ntpcsync", (FAR char *)ntp_server_list, NULL};
+  int ret;
+
+  if (ntp_server_list == NULL || *ntp_server_list == '\0')
+    {
+      return -EINVAL;
+    }
+
+  if (sem_trywait(&sync_lock) < 0)
+    {
+      return errno == EAGAIN ? -EBUSY : -errno;
+    }
+
+  while (sem_wait(&g_ntpc_daemon.lock) < 0)
+    {
+      if (errno != EINTR)
+        {
+          ret = -errno;
+          sem_post(&sync_lock);
+          return ret;
+        }
+    }
+
+  g_last_nsamples = 0;
+  g_ntpc_daemon.state = NTP_STARTED;
+  sem_post(&g_ntpc_daemon.lock);
+  ret = ntpc_daemon(2, argv);
+  g_ntpc_daemon.state = NTP_STOPPED;
+  sem_post(&sync_lock);
+  return ret == EXIT_SUCCESS ? OK : -EIO;
+#endif
+}
+#endif
