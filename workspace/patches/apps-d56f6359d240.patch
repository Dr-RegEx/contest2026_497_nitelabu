+  /* STOP success joins accepted callbacks. Keep the mapped ring for the
+   * next prepare; a failed STOP must retain the old state and buffers.
+   */
+
+  if (ioctl(hw->fd, AUDIOIOC_STOP, 0) < 0)
+    {
+      return -errno;
+    }
